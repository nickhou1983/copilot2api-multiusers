# Copy to .env and fill in before running `docker compose up`.

# Protects the admin UI. Required: without it anyone who can reach the UI can
# trigger a GitHub login using the stored credentials.
COPILOT2API_ADMIN_TOKEN=change-me-admin

# Shared secret between copilot2api and the login agent.
LOGIN_AGENT_TOKEN=change-me-agent

# Host port to publish the proxy on (loopback only). Change it if 7777 is
# already taken on this machine.
#COPILOT2API_HOST_PORT=7777
